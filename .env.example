# PayPal Configuration
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here

# Email Configuration (for order confirmations and notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
BUSINESS_EMAIL=business@zevitech.com

# Hostinger SMTP Configuration (for dual delivery)
HOSTINGER_EMAIL_HOST=smtp.hostinger.com
HOSTINGER_EMAIL_PORT=465
HOSTINGER_EMAIL_USER=your_hostinger_email@domain.com
HOSTINGER_EMAIL_PASSWORD=your_hostinger_app_password_here
HOSTINGER_EMAIL_TO=forward_recipient@domain.com

# Environment
NODE_ENV=development

# Public site URL — used for metadataBase, canonical URLs, sitemap and robots
NEXT_PUBLIC_FRONTEND_URL=https://zevitech.com

# Google Ads landing page — lead inbox (isolated from other forms)
GOOGLE_ADS_LEAD_EMAIL=

# Calendly scheduler URL for the Google Ads "book a call" modal
# Must start with https://calendly.com/ — e.g. https://calendly.com/your-handle/your-event
NEXT_PUBLIC_CALENDLY_URL=
